# ==============================================================================
# HiStudy Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the 'app/' directory and replace the placeholders
# with your actual configuration values.
# NEVER commit your actual '.env' file containing secrets to version control.
# ==============================================================================

# Supabase Backend Configuration
# ------------------------------------------------------------------------------
# The URL of your Supabase project instance (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public API Key (safe to use in browser with RLS enabled)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ImgBB Image Hosting API Configuration
# ------------------------------------------------------------------------------
# API key for client-side avatar and media uploads via ImgBB
VITE_IMGBB_API_KEY=your_imgbb_api_key_here

# Mock Server / Local API Configuration
# ------------------------------------------------------------------------------
# Fallback local json-server base endpoint for offline development
VITE_MOCK_API_BASE_URL=http://localhost:3000
